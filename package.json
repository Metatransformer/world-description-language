{
  "name": "world-description-language",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "game": "node scripts/run-game.mjs",
    "game:editor": "node scripts/run-game.mjs --editor",
    "game:web": "node scripts/run-game.mjs --web",
    "game:explorer": "node scripts/run-game.mjs --explorer",
    "game:spawn": "node scripts/run-game.mjs --spawn",
    "game:spawn:explorer": "node scripts/run-game.mjs --spawn --explorer",
    "game:spawn:web": "node scripts/run-game.mjs --spawn --web",
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:mcp": "WDL_MCP_INTEGRATION=1 vitest run tests/mcp.test.ts",
    "compile": "tsx scripts/compile.ts",
    "mcp": "tsx src/server/mcp.ts",
    "game:build": "tsx scripts/build-game.ts",
    "game:watch": "tsx scripts/build-game.ts --watch",
    "game:three": "vite --config examples/three-runtime/vite.config.ts",
    "game:three:build": "vite build --config examples/three-runtime/vite.config.ts",
    "game:verify": "tsx scripts/verify-game.ts",
    "docs:dev": "node scripts/build-agent-docs.mjs && vitepress dev docs --host 127.0.0.1 --port 4173",
    "docs:build": "node scripts/build-agent-docs.mjs && vitepress build docs",
    "docs:preview": "vitepress preview docs --host 127.0.0.1 --port 4173",
    "game:spawn:build": "tsx scripts/build-game.ts --entry worlds/spawn-demo.tsx",
    "game:spawn:editor": "node scripts/run-game.mjs --spawn --editor"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.20.2",
    "@playwright/test": "^1.56.1",
    "esbuild": "^0.25.11",
    "highlight.js": "^11.12.0",
    "next": "^15.5.6",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "three": "^0.180.0",
    "typescript": "^5.9.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.9.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/three": "^0.187.0",
    "tsx": "^4.20.6",
    "vite": "^7.3.0",
    "vitepress": "^1.6.4",
    "vitest": "^5.1.0"
  },
  "license": "MIT",
  "description": "Generative World Studio: compose portable game worlds in JSX and integrate with native engines.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Metatransformer/world-description-language.git"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "postcss": "^8.5.23"
  }
}
