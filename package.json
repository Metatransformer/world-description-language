{
  "name": "world-description-language",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:mcp": "WDL_MCP_INTEGRATION=1 vitest run tests/mcp.test.ts",
    "compile": "tsx scripts/compile.ts",
    "mcp": "tsx src/server/mcp.ts",
    "game:build": "tsx scripts/build-game.ts",
    "game:watch": "tsx scripts/build-game.ts --watch",
    "game:three": "vite --config examples/three-runtime/vite.config.ts",
    "game:three:build": "vite build --config examples/three-runtime/vite.config.ts",
    "game:verify": "tsx scripts/verify-game.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.20.2",
    "@playwright/test": "^1.56.1",
    "esbuild": "^0.25.11",
    "highlight.js": "^11.12.0",
    "next": "^15.5.6",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "three": "^0.180.0",
    "typescript": "^5.9.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.9.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/three": "^0.187.0",
    "tsx": "^4.20.6",
    "vite": "^7.3.0",
    "vitest": "^5.1.0"
  },
  "license": "MIT",
  "description": "Compose game worlds in TypeScript and JSX. Preview in Three.js, export to Blender, and author with MCP.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Metatransformer/world-description-language.git"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "postcss": "^8.5.23"
  }
}
