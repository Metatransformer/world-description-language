config_version=5

[application]
config/name="WDL · Alder Vale"
run/main_scene="res://Main.tscn"
config/features=PackedStringArray("4.7", "C#", "GL Compatibility")

[display]
window/size/viewport_width=1280
window/size/viewport_height=800
window/stretch/mode="canvas_items"

[dotnet]
project/assembly_name="WdlDemo"

[rendering]
renderer/rendering_method="gl_compatibility"
environment/defaults/default_clear_color=Color(0.1, 0.16, 0.22, 1)

[editor_plugins]
enabled=PackedStringArray("res://addons/wdl/plugin.cfg")
