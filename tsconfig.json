{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "strict": true,
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowJs": false,
    "isolatedModules": true,
    "jsx": "preserve",
    "jsxImportSource": "wdl",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "wdl/*": ["./src/wdl/*"]
    },
    "types": ["node", "vitest/globals"],
    "skipLibCheck": true,
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    "scripts/**/*.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "tests/**/*.ts",
    "tests/**/*.tsx",
    "worlds/**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules", ".wdl"]
}
